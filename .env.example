# Copy to .env.local. NEXT_PUBLIC_* values are inlined into the static build
# and visible to anyone — that's expected for Firebase web config, which
# identifies the project; access is controlled by firebase/*.rules.

# Which backend the web app talks to. Build-time: each build targets one.
# local | firebase | http
#   http      the API in server/ (the default for development). Run it beside
#             the web app: `npm run db:migrate` and `npm run db:seed` once, then
#             `npm run api:dev` (API on :8787) and `npm run dev` (web on :3000).
#             See README, "Run locally".
#   local     the demo fallback: no API, accounts and data live in the
#             browser's localStorage, demo sign-in buttons on the login page.
#             The investor demo builds this (docs/DEMO.md).
#   firebase  a stub, not used (docs/PLAN.md, decision 10).
# Unset counts as local, so a build nobody configured still works offline.
NEXT_PUBLIC_BACKEND=http

# The API's origin for the http adapter (src/lib/backend/http/README.md).
# Build-time, visible to anyone. In development the API runs on its own port and
# allows APP_URL's origin with cookies. Empty means the page's own origin, as in
# the production image, which serves the app and the API together:
# NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# Needed once NEXT_PUBLIC_BACKEND=firebase (Firebase console → Project settings → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
# true → connect to `firebase emulators:start` instead of the real project
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Public site: the address the site is served from, for canonical links,
# Open Graph tags and sitemap.xml. Falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# API and local infrastructure (planning/v1/04-infrastructure.md). Read by the
# API in server/ once it exists; the static web app ignores them. Start the
# containers with `npm run infra:up` (see README, "Local infrastructure").
# ---------------------------------------------------------------------------

# Database (libSQL). Local default: a file database, no token, no container.
TURSO_DATABASE_URL=file:./data/breathband.db
# Shared option: a Turso database. Put its libsql:// URL above and the token
# here, in .env.local only (never commit either). Leave empty for a file DB.
# Tests never use a libsql:// URL; they run on a file database.
# TURSO_AUTH_TOKEN=<turso-auth-token>

# Signs session cookies and tokens. Generate one with `openssl rand -base64 32`.
# Required in production (32+ characters); development and tests fall back to a
# public dev-only value, so leave it empty locally if you like.
AUTH_SECRET=<generate-a-random-32-byte-secret>
# Where the web app is served. Trusted as a request origin and as the target of
# links in auth emails.
APP_URL=http://localhost:3000
# Port the API listens on in development.
API_PORT=8787
# The API's public address; auth email links start here. Empty means APP_URL in
# production (one service serves both) and http://localhost:$API_PORT otherwise.
# API_URL=http://localhost:8787
# How many proxies in front of the API append to X-Forwarded-For. The rate
# limits key on the client's address: 0 (the default) ignores the header and
# uses the connection's address, which is right with no proxy (local, a VM,
# `docker compose --profile full`). Cloud Run's count is still open: expected
# 1 for Cloud Run alone and 2 behind an external load balancer; confirm before
# deploy (see docs/deploy.md). Too high lets clients choose their own bucket;
# too low makes everyone share one.
# TRUSTED_PROXY_HOPS=0

# Outgoing email. Locally this is Mailpit from docker-compose.yml (inbox on :8025).
# Required in production; without it, development prints emails to the console.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Breathband <no-reply@breathband.local>"
# A provider's SMTP login, in .env.local only. Mailpit needs none.
# SMTP_USER=<smtp-user>
# SMTP_PASS=<smtp-password>
# Set to 1 to run server/auth.mailpit.test.ts against Mailpit (after `npm run infra:up`).
# MAILPIT_E2E=1

# Where the API keeps uploaded files (waveform blobs). Gitignored under /data/.
STORAGE_DIR=./data/blobs
