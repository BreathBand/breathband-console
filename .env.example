# Copy to .env.local. NEXT_PUBLIC_* values are inlined into the static build
# and visible to anyone — that's expected for Firebase web config, which
# identifies the project; access is controlled by firebase/*.rules.

# local | firebase | http
NEXT_PUBLIC_BACKEND=local

# Needed once NEXT_PUBLIC_BACKEND=http (base URL of the future Cloud Run API, see src/lib/backend/http/README.md)
# NEXT_PUBLIC_API_BASE_URL=

# Needed once NEXT_PUBLIC_BACKEND=firebase (Firebase console → Project settings → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
# true → connect to `firebase emulators:start` instead of the real project
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Public site: the address the site is served from, for canonical links,
# Open Graph tags and sitemap.xml. Falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# API and local infrastructure (planning/v1/04-infrastructure.md). Read by the
# API in server/ once it exists; the static web app ignores them. Start the
# containers with `npm run infra:up` (see README, "Local infrastructure").
# ---------------------------------------------------------------------------

# Database (libSQL). Local default: a file database, no token, no container.
TURSO_DATABASE_URL=file:./data/breathband.db
# Shared option: a Turso database. Put its libsql:// URL above and the token
# here, in .env.local only (never commit either). Leave empty for a file DB.
# Tests never use a libsql:// URL; they run on a file database.
# TURSO_AUTH_TOKEN=<turso-auth-token>

# Signs session cookies and tokens. Generate one with `openssl rand -base64 32`.
AUTH_SECRET=<generate-a-random-32-byte-secret>
# Where the web app is served; links in emails point here.
APP_URL=http://localhost:3000
# Port the API listens on in development.
API_PORT=8787

# Outgoing email. Locally this is Mailpit from docker-compose.yml (inbox on :8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Breathband <no-reply@breathband.local>"

# Where the API keeps uploaded files (waveform blobs). Gitignored under /data/.
STORAGE_DIR=./data/blobs

# Base URL the http adapter calls for the API. Build-time, visible to anyone.
# Empty means same origin (the production image).
# NEXT_PUBLIC_API_URL=http://localhost:8787
