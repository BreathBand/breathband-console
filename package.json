{
  "name": "breathband-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "preview": "npx --yes serve@14.2.4 out",
    "docker:smoke": "node scripts/docker-smoke.mjs",
    "infra:up": "docker compose up -d --wait mail",
    "infra:down": "docker compose --profile \"*\" down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:reset": "tsx server/db/reset.ts",
    "db:seed": "tsx server/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "api:dev": "tsx watch --env-file=server/development.env server/main.ts",
    "api:start": "tsx server/main.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "@libsql/client": "0.18.0",
    "better-auth": "1.7.28",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.22",
    "next": "16.4.6",
    "nodemailer": "10.6.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
