rules_version = '2';

// DRAFT — not deployed. Waveform blobs live at waveforms/{athleteId}/{sessionId}.json.gz.
// The athlete can read their own; a coach needs a link with the "curves" scope
// (a "scores" link sees the session documents in Firestore but not the signal).

service firebase.storage {
  match /b/{bucket}/o {
    match /waveforms/{athleteId}/{file} {
      allow read: if request.auth != null
                  && (request.auth.uid == athleteId
                      || firestore.get(/databases/(default)/documents/coachLinks/$(request.auth.uid + '_' + athleteId)).data.scope == 'curves');
      allow write: if request.auth != null
                   && request.auth.uid == athleteId
                   && request.resource.size < 5 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
