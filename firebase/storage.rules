rules_version = '2';

// DRAFT — not deployed. Waveform blobs live at waveforms/{athleteId}/{sessionId}.json.gz
// and follow the same access rule as the session documents in Firestore.

service firebase.storage {
  match /b/{bucket}/o {
    match /waveforms/{athleteId}/{file} {
      allow read: if request.auth != null
                  && (request.auth.uid == athleteId
                      || firestore.exists(/databases/(default)/documents/coachLinks/$(request.auth.uid + '_' + athleteId)));
      allow write: if request.auth != null
                   && request.auth.uid == athleteId
                   && request.resource.size < 5 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
