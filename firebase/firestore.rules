rules_version = '2';

// DRAFT — not deployed. Mirrors the access checks in
// src/lib/backend/local/index.ts. Test against the emulator
// (`firebase emulators:start`) before the first deploy; see docs/PLAN.md.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function coachLinked(coachId, athleteId) {
      return exists(/databases/$(database)/documents/coachLinks/$(coachId + '_' + athleteId));
    }

    function canReadAthlete(athleteId) {
      return isSelf(athleteId) || (signedIn() && coachLinked(request.auth.uid, athleteId));
    }

    // A professional's kind and practice (lib/domain/types.ts `proKind`, `proProfile`).
    function proFieldsOk(before, after) {
      return (after.get('proKind', null) == null && after.get('proProfile', null) == null)
          || (before.role == 'coach'
              && after.get('proKind', null) in ['coach', 'clinician', 'educator']
              && (after.get('proProfile', null) == null
                  || (after.proProfile.kind == after.proKind
                      && after.proProfile.terminology in ['athletes', 'clients', 'students'])));
    }

    // Profiles: readable by the owner and by either side of a coach link.
    match /users/{uid} {
      allow read: if canReadAthlete(uid)
                  || (signedIn() && coachLinked(uid, request.auth.uid));
      // Sign-up carries the 16+ age gate (by year of birth) and one consent
      // record per kind, in lib/domain/consent.ts order. Versions are checked
      // by the client and adapter, not here. proKind and proProfile come later,
      // from onboarding (update rule below), never at sign-up: the adapter's
      // signUp doesn't take them either.
      allow create: if isSelf(uid)
                    && request.resource.data.get('proKind', null) == null
                    && request.resource.data.get('proProfile', null) == null
                    && request.resource.data.role in ['athlete', 'coach']
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.birthYear is int
                    && request.resource.data.birthYear <= request.time.year() - 16
                    && request.resource.data.consents is list
                    && request.resource.data.consents.size() == 3
                    && request.resource.data.consents[0].kind == 'terms'
                    && request.resource.data.consents[1].kind == 'privacy'
                    && request.resource.data.consents[2].kind == 'breathing-data';
      // Role, email, consents and birth year are fixed after sign-up.
      // proKind and proProfile are for professionals (role "coach") only, and the
      // profile's kind matches proKind; the rest of proProfile is checked by the
      // client and adapter (lib/domain/pro-profile.ts), not here.
      allow update: if isSelf(uid)
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.get('consents', null) == resource.data.get('consents', null)
                    && request.resource.data.get('birthYear', null) == resource.data.get('birthYear', null)
                    && proFieldsOk(resource.data, request.resource.data);
      allow delete: if false; // Account deletion runs in a Cloud Function.

      // Sessions: written by the athlete's app, read by them and linked coaches.
      match /sessions/{sessionId} {
        allow read: if canReadAthlete(uid);
        allow create: if isSelf(uid) && request.resource.data.athleteId == uid;
        // After upload, only the note may change.
        allow update: if isSelf(uid)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note']);
        allow delete: if isSelf(uid);

        // Comments and kudos: the athlete and linked coaches, each as themselves.
        // Read across sessions with a collection-group query on athleteId.
        match /comments/{commentId} {
          allow read: if canReadAthlete(uid);
          allow create: if canReadAthlete(uid)
                        && request.resource.data.athleteId == uid
                        && request.resource.data.sessionId == sessionId
                        && request.resource.data.authorId == request.auth.uid
                        && request.resource.data.kind in ['comment', 'kudos']
                        && request.resource.data.text is string
                        && request.resource.data.text.size() <= 1000;
          allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
          allow update: if false;
        }
      }

      // Practice a linked coach sets. The athlete's app reads them; only the
      // coach who set one can cancel it, and nothing else changes after that.
      match /assignments/{assignmentId} {
        allow read: if canReadAthlete(uid);
        allow create: if signedIn()
                      && coachLinked(request.auth.uid, uid)
                      && request.resource.data.coachId == request.auth.uid
                      && request.resource.data.athleteId == uid
                      && request.resource.data.cancelled == false
                      && request.resource.data.target is int
                      && request.resource.data.target >= 1
                      && request.resource.data.target <= 30
                      && request.resource.data.note.size() <= 500;
        allow update: if signedIn()
                      && resource.data.coachId == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelled']);
        allow delete: if false;
      }
    }

    // Coach links: created only by the redeemInvite Cloud Function (Admin SDK
    // bypasses rules). Either party can see the link; the athlete can change
    // its scope or revoke it.
    match /coachLinks/{linkId} {
      allow read: if signedIn()
                  && (resource.data.coachId == request.auth.uid
                      || resource.data.athleteId == request.auth.uid);
      // The athlete changes the scope; the coach sets their targets.
      allow update: if signedIn()
                    && ((resource.data.athleteId == request.auth.uid
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scope'])
                         && request.resource.data.scope in ['scores', 'curves'])
                        || (resource.data.coachId == request.auth.uid
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['targets'])));
      allow delete: if signedIn() && resource.data.athleteId == request.auth.uid;
      allow create: if false;
    }

    // Live group sessions. Created by the createGroupSession Cloud Function,
    // which checks the host is linked to every invited athlete. The host runs
    // it (start, pacer, markers, end); `results` and `groupAverage` are filled
    // in by a Cloud Function as each athlete's app saves its session. The live
    // signal itself goes over the Realtime Database (database.rules.json).
    match /groupSessions/{groupId} {
      allow read: if signedIn()
                  && (resource.data.hostId == request.auth.uid
                      || request.auth.uid in resource.data.athleteIds);
      allow create, delete: if false;
      allow update: if signedIn()
                    && resource.data.hostId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'startedAt', 'endedAt', 'pacerChanges', 'markers'])
                    && request.resource.data.status in ['lobby', 'live', 'ended', 'cancelled'];
    }

    // listComments(athleteId) without a session: a collection-group query
    // filtered on athleteId (index in firestore.indexes.json).
    match /{path=**}/comments/{commentId} {
      allow read: if canReadAthlete(resource.data.athleteId);
    }

    // A coach's own working data: sessions they've opened ("athleteId_sessionId"),
    // private notes per athlete, squads and alert settings. Nobody else, including the athlete, reads it.
    match /coaches/{coachId}/{collection}/{docId} {
      allow read, write: if isSelf(coachId) && collection in ['seen', 'athleteNotes', 'squads', 'settings'];
    }

    // Invites: athletes create their own; nobody reads them client-side —
    // redemption goes through the Cloud Function.
    match /invites/{code} {
      allow create: if signedIn()
                    && request.resource.data.athleteId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['code', 'athleteId', 'scope', 'expiresAt'])
                    && request.resource.data.scope in ['scores', 'curves'];
      allow read, update, delete: if false;
    }

    // Coach-to-athlete invites. The coach creates and revokes them; athletes
    // open them through the getCoachInvite / respondToCoachInvite Cloud
    // Functions, which hide the contact details and create the coach link.
    match /coachInvites/{code} {
      allow read: if signedIn() && resource.data.coachId == request.auth.uid;
      allow create: if signedIn()
                    && request.resource.data.coachId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.athleteId == null;
      allow update: if signedIn()
                    && resource.data.coachId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status == 'revoked';
      allow delete: if false;
    }

    // Waitlist: anyone may add themselves; nobody can read the list from a client.
    match /waitlist/{entryId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'createdAt'])
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.source is string
                    && request.resource.data.source.size() <= 32;
      allow read, update, delete: if false;
    }
  }
}
